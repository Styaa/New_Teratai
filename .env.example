# Musim aktif: reguler | lebaran | natal | imlek
PUBLIC_MUSIM=natal

# Opsional: ambil katalog dari API admin saat build (bentuk data sama dengan src/data/katalog-db.json).
# Kosongkan untuk memakai src/data/katalog-db.json.
ADMIN_API_URL=

# Opsional: alamat folder foto produk di server admin. File dipanggil sebagai {PUBLIC_FOTO_BASE}/{id}.{ext}
# sesuai tabel `gambar`. Kosongkan untuk memakai placeholder bertanda.
PUBLIC_FOTO_BASE=
