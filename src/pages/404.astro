---
import Base from '@/layouts/Base.astro';
---
<Base judul="Halaman tidak ditemukan" deskripsi="Halaman yang kamu cari tidak ada di Teratai Cookies." noindex>
  <section class="wadah kosong">
    <span class="eyebrow">404</span>
    <h1>Halaman ini tidak ditemukan</h1>
    <p class="lead">Mungkin tautannya sudah berubah. Yuk kembali melihat kue-kue kami.</p>
    <div class="aksi">
      <a class="btn" href="/produk/">Lihat Semua Kue</a>
      <a class="btn btn--garis" href="/">Ke Beranda</a>
    </div>
  </section>
</Base>
<style>
  .kosong { padding-block: 80px 120px; text-align: center; display: grid; justify-items: center; }
  .aksi { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 16px; }
</style>
