---
import Base from '@/layouts/Base.astro';
import Foto from '@/components/Foto.astro';
import Jejak from '@/components/Jejak.astro';
import { KELUARGA_USAHA, SITUS } from '@/config/situs';

const PROSES = [
  { judul: 'Memilih bahan', teks: 'Mentega, keju, kacang mete, dan nanas untuk selai kami pilih sendiri.', foto: 'Bahan-bahan di meja dapur' },
  { judul: 'Membuat adonan', teks: 'Adonan dibuat dan dibentuk dengan tangan, sedikit demi sedikit.', foto: 'Tangan membentuk nastar' },
  { judul: 'Memanggang', teks: 'Dipanggang sampai matang merata, lalu didinginkan sebelum dikemas.', foto: 'Loyang keluar dari oven' },
  { judul: 'Mengemas', teks: 'Disusun rapi ke dalam mika atau toples agar tetap renyah sampai di rumahmu.', foto: 'Toples tersusun siap dikirim' },
];
---
<Base
  judul="Tentang Teratai Cookies Makassar"
  deskripsi="Cerita dapur Teratai Cookies di Makassar: kue kering rumahan, proses pembuatan, dan keluarga usaha Mie Ayam Teratai serta Jalangkote Lasinrang."
>
  <Jejak jejak={[{ nama: 'Tentang Kami', href: '/tentang/' }]} />
  <header class="wadah kepala-halaman tentang-kepala">
    <div>
      <span class="eyebrow">Tentang kami</span>
      <h1>Dari dapur rumah di Makassar</h1>
      <p class="lead">{SITUS.namaLengkap} adalah usaha keluarga yang membuat kue kering, cake, dan hampers untuk pelanggan di Makassar.</p>
    </div>
    <Foto foto={{ src: null, alt: 'Suasana dapur Teratai saat membuat kue kering', label: 'Suasana dapur Teratai' }} jenis="dapur" rasio="4 / 3" eager sizes="(min-width: 900px) 520px, 100vw" />
  </header>

  <section class="bagian" aria-labelledby="judul-cerita">
    <div class="wadah prosa">
      <h2 id="judul-cerita">Cerita kami</h2>
      <p><span class="tanda">[cerita singkat pendiri]</span> Ceritakan bagaimana Teratai dimulai, siapa yang memulainya, dan resep apa yang pertama kali dibuat.</p>
      <p><span class="tanda">[tahun berdiri]</span> {SITUS.tahunBerdiri ? `Berdiri sejak ${SITUS.tahunBerdiri}.` : 'Tahun berdiri akan ditampilkan setelah dikonfirmasi.'}</p>
      <p>Hari ini kami melayani pelanggan dari dua outlet, Pelita dan Hertasning, dan menyiapkan kue untuk Lebaran, Natal, Imlek, serta hantaran kantor sepanjang tahun.</p>
    </div>
  </section>

  <section class="bagian bagian--cream" aria-labelledby="judul-proses">
    <div class="wadah">
      <span class="eyebrow">Proses</span>
      <h2 id="judul-proses">Bagaimana kue kami dibuat</h2>
      <ol class="proses">
        {PROSES.map((p, i) => (
          <li>
            <Foto foto={{ src: null, alt: p.foto, label: p.foto }} jenis="dapur" rasio="4 / 3" sizes="(min-width: 900px) 280px, 50vw" />
            <span class="proses__no angka">0{i + 1}</span>
            <h3>{p.judul}</h3>
            <p>{p.teks}</p>
          </li>
        ))}
      </ol>
      <p class="catatan"><span class="tanda">[perlu konfirmasi]</span> Pastikan urutan dan klaim proses sesuai praktik di dapur.</p>
    </div>
  </section>

  <section class="bagian" aria-labelledby="judul-tim">
    <div class="wadah">
      <h2 id="judul-tim">Tim di balik dapur</h2>
      <div class="tim">
        {[1, 2, 3].map((n) => (
          <figure>
            <Foto foto={{ src: null, alt: `Foto anggota tim Teratai ${n}`, label: `Foto tim ${n}` }} jenis="tim" rasio="1 / 1" sizes="(min-width: 900px) 280px, 33vw" />
            <figcaption><span class="tanda">[nama & peran]</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bagian bagian--cream" aria-labelledby="judul-keluarga">
    <div class="wadah">
      <span class="eyebrow">Dari dapur yang sama</span>
      <h2 id="judul-keluarga">Keluarga usaha Teratai</h2>
      <ul class="keluarga">
        {KELUARGA_USAHA.map((k) => <li><strong>{k.nama}</strong><span>{k.deskripsi}</span></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .tentang-kepala { display: grid; gap: 28px; align-items: center; }
  .tentang-kepala :global(.foto) { border-radius: 20px; }
  @media (min-width: 900px) { .tentang-kepala { grid-template-columns: 1fr 1fr; gap: 56px; } }
  .proses { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 24px 16px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .proses { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  .proses li :global(.foto) { border-radius: var(--r); margin-bottom: 12px; }
  .proses__no { font-size: 0.75rem; font-weight: 600; color: var(--teks-aksen); }
  .proses h3 { margin: 4px 0 6px; }
  .proses p { font-size: 0.9375rem; color: var(--teks-2); margin: 0; }
  .catatan { margin-top: 24px; font-size: 0.875rem; color: var(--teks-2); }
  .tim { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 20px; }
  @media (min-width: 900px) { .tim { gap: 24px; max-width: 900px; } }
  .tim figure { margin: 0; }
  .tim :global(.foto) { border-radius: var(--r); }
  .tim figcaption { margin-top: 8px; font-size: 0.875rem; }
  .keluarga { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 12px; }
  @media (min-width: 768px) { .keluarga { grid-template-columns: 1fr 1fr; gap: 20px; } }
  .keluarga li { background: #fff; border: 1px solid var(--garis); border-radius: var(--r-lg); padding: 20px; display: grid; gap: 4px; }
  .keluarga strong { font-family: var(--font-judul); font-size: 1.0625rem; }
  .keluarga span { color: var(--teks-2); }
</style>
