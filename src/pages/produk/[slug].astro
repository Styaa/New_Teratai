---
import Base from '@/layouts/Base.astro';
import Foto from '@/components/Foto.astro';
import Icon from '@/components/Icon.astro';
import Jejak from '@/components/Jejak.astro';
import ProductCard from '@/components/ProductCard.astro';
import Rak from '@/components/Rak.astro';
import VariantPicker from '@/components/VariantPicker.astro';
import { OUTLET, SITUS } from '@/config/situs';
import { getKatalog, namaKategori } from '@/lib/katalog';
import { linkWa, rupiah } from '@/lib/pesan-wa';
import { schemaProduk } from '@/lib/seo';
import type { Alergen, Produk } from '@/lib/types';

export async function getStaticPaths() {
  const katalog = await getKatalog();
  return katalog.map((produk) => ({ params: { slug: produk.slug }, props: { produk } }));
}

const { produk: p } = Astro.props as { produk: Produk };
const katalog = await getKatalog();
const jenis = p.kategori === 'hampers' ? 'hampers' : p.kategori === 'cake' ? 'cake' : 'toples';

// Rekomendasi: kategori sama, favorit dulu, lalu terlaris
const rekomendasi = katalog
  .filter((x) => x.slug !== p.slug && x.kategori === p.kategori)
  .sort((a, b) => Number(b.best) - Number(a.best) || a.peringkat - b.peringkat)
  .slice(0, 8);

const SEMUA_ALERGEN: { id: Alergen; nama: string }[] = [
  { id: 'kacang', nama: 'Kacang' },
  { id: 'susu', nama: 'Susu' },
  { id: 'telur', nama: 'Telur' },
  { id: 'gluten', nama: 'Gluten (terigu)' },
];
const adaInfoAlergen = !!p.komposisi;
const kataKunci = p.kategori === 'kue-kering' ? `Kue ${p.nama} Makassar` : `${p.nama} Makassar`;
const deskripsiMeta = `${p.nama} dari Teratai Cookies Makassar. ${p.ringkas} ${p.hargaMulai ? `Mulai ${rupiah(p.hargaMulai)}.` : ''} Pesan via WhatsApp, ambil di Pelita atau Hertasning.`.replace(/\s+/g, ' ').trim();
const waTanya = linkWa(SITUS.whatsapp, `Halo Teratai Cookies, saya mau tanya tentang ${p.nama}.`);
const paragraf = p.deskripsi.split('\n').filter(Boolean);
---
<Base judul={kataKunci} deskripsi={deskripsiMeta.slice(0, 158)} jsonLd={schemaProduk(p)} tipeOg="product">
  <Jejak jejak={[{ nama: 'Produk', href: '/produk/' }, { nama: namaKategori(p.kategori), href: `/produk/?kategori=${p.kategori}` }, { nama: p.nama, href: `/produk/${p.slug}/` }]} />

  <article class="wadah detail">
    <div class="detail__galeri" data-galeri>
      <div class="detail__utama">
        {p.foto.map((f, i) => (
          <div class="detail__slide" data-slide={i} hidden={i !== 0}>
            <Foto foto={f} jenis={i === 0 ? jenis : 'kue'} rasio="1 / 1" eager={i === 0} sizes="(min-width: 900px) 560px, 100vw" />
          </div>
        ))}
        {p.best && <span class="badge badge--favorit detail__badge">Favorit</span>}
      </div>
      {p.foto.length > 1 && (
        <div class="detail__thumbs" role="group" aria-label="Pilih foto">
          {p.foto.map((f, i) => (
            <button type="button" class="detail__thumb" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Foto ${i + 1}: ${f.label}`} data-thumb={i}>
              <Foto foto={f} jenis={i === 0 ? jenis : 'kue'} rasio="1 / 1" label={false} sizes="96px" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="detail__info">
      <span class="eyebrow">{p.merek ?? namaKategori(p.kategori)}</span>
      <h1>{p.nama}</h1>
      <p class="detail__ringkas">{p.ringkas}</p>

      <VariantPicker produk={p} />

      <ul class="detail__jaminan">
        <li><Icon nama="toko" ukuran={20} /> Ambil di {OUTLET.map((o) => o.nama.replace('Teratai ', '')).join(' atau ')}</li>
        <li><Icon nama="truk" ukuran={20} /> Bisa diantar, ongkir dikonfirmasi admin</li>
        <li><Icon nama="kalender" ukuran={20} /> Hampers & partai besar: pesan minimal H-{SITUS.preorderHari}</li>
      </ul>

      <div class="detail__seksi">
        <h2>Deskripsi</h2>
        {paragraf.length ? paragraf.map((t) => <p>{t}</p>) : <p><span class="tanda">[deskripsi {p.nama}]</span></p>}
      </div>

      <div class="detail__seksi">
        <h2>Komposisi</h2>
        {p.komposisi ? <p>{p.komposisi}</p> : <p><span class="tanda">[komposisi {p.nama}]</span></p>}
      </div>

      <div class="detail__seksi">
        <h2>Info alergen</h2>
        {adaInfoAlergen ? (
          <>
            <ul class="alergen">
              {SEMUA_ALERGEN.map((a) => {
                const ada = p.alergen.includes(a.id);
                return <li class:list={['alergen__item', { 'alergen__item--ada': ada }]}>{ada ? <Icon nama="info" ukuran={16} /> : <Icon nama="centang" ukuran={16} />}{ada ? 'Mengandung' : 'Tidak tercantum'}: {a.nama}</li>;
              })}
            </ul>
            <p class="detail__kecil">Dibaca otomatis dari komposisi. Kue dibuat di dapur yang juga mengolah kacang, susu, telur, dan terigu. <span class="tanda">[perlu konfirmasi]</span></p>
          </>
        ) : (
          <p class="detail__kecil">Info alergen untuk produk ini belum tersedia. Tanyakan lewat WhatsApp sebelum memesan bila kamu punya alergi.</p>
        )}
      </div>

      <a class="tautan-panah" href={waTanya} target="_blank" rel="noopener"><Icon nama="whatsapp" ukuran={18} /> Tanya tentang {p.nama}</a>
    </div>
  </article>

  {rekomendasi.length > 0 && (
    <section class="bagian bagian--cream" aria-labelledby="judul-rekomendasi">
      <div class="wadah">
        <div class="kepala-bagian">
          <div>
            <span class="eyebrow">Sekalian dicoba</span>
            <h2 id="judul-rekomendasi">{p.kategori === 'kue-kering' ? 'Rasa lain yang sering dipesan' : 'Pilihan lainnya'}</h2>
          </div>
        </div>
        <Rak label="Rekomendasi produk">
          {rekomendasi.map((r) => <ProductCard produk={r} />)}
        </Rak>
      </div>
    </section>
  )}
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-galeri]').forEach((g) => {
    const slides = g.querySelectorAll<HTMLElement>('[data-slide]');
    const thumbs = g.querySelectorAll<HTMLButtonElement>('[data-thumb]');
    thumbs.forEach((t) => t.addEventListener('click', () => {
      const i = t.dataset.thumb;
      slides.forEach((s) => (s.hidden = s.dataset.slide !== i));
      thumbs.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
    }));
  });
</script>

<style>
  .detail { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 16px 64px; }
  @media (min-width: 900px) {
    .detail { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 56px; padding-block: 32px 96px; align-items: start; }
    .detail__galeri { position: sticky; top: calc(var(--header-h) + 24px); }
  }
  .detail__utama { position: relative; border-radius: 20px; overflow: hidden; }
  .detail__slide[hidden] { display: none; }
  .detail__badge { position: absolute; top: 14px; left: 14px; z-index: 3; }
  .detail__thumbs { display: flex; gap: 10px; margin-top: 12px; }
  .detail__thumb {
    width: 72px; padding: 0; border: 2px solid transparent; border-radius: 12px; overflow: hidden; cursor: pointer; background: none;
    transition: border-color var(--durasi);
  }
  .detail__thumb[aria-pressed='true'] { border-color: var(--tombol); }
  .detail__info h1 { font-size: clamp(2rem, 6vw, 3rem); margin-bottom: 8px; }
  .detail__ringkas { color: var(--teks-2); font-size: 1.0625rem; margin-bottom: 20px; }
  .detail__jaminan { list-style: none; padding: 16px 0; margin: 24px 0 8px; border-block: 1px solid var(--garis); display: grid; gap: 10px; font-size: 0.9375rem; color: var(--teks-2); }
  .detail__jaminan li { display: flex; gap: 10px; align-items: flex-start; }
  .detail__jaminan :global(svg) { flex: none; color: var(--terracotta); margin-top: 2px; }
  .detail__seksi { padding-block: 16px; border-bottom: 1px solid var(--garis); }
  .detail__seksi h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; color: var(--teks-2); margin-bottom: 10px; }
  .detail__seksi p:last-child { margin-bottom: 0; }
  .detail__kecil { font-size: 0.8125rem; color: var(--teks-2); margin-top: 10px; }
  .alergen { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .alergen__item { display: flex; align-items: center; gap: 6px; font-size: 0.8125rem; padding: 8px 10px; border-radius: var(--r-sm); background: #fff; border: 1px solid var(--garis); color: var(--teks-2); }
  .alergen__item--ada { background: #fdf3e7; border-color: #f0d9bd; color: #6b3f12; font-weight: 500; }
  .detail__info > .tautan-panah { margin-top: 12px; }
</style>
