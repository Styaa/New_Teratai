---
import Base from '@/layouts/Base.astro';
import Foto from '@/components/Foto.astro';
import Icon from '@/components/Icon.astro';
import Jejak from '@/components/Jejak.astro';
import ProductCard from '@/components/ProductCard.astro';
import { DAFTAR_MUSIM, MUSIM_AKTIF } from '@/config/musim';
import { SITUS } from '@/config/situs';
import { getKatalog } from '@/lib/katalog';
import type { MusimId } from '@/lib/types';

const katalog = await getKatalog();
const hampers = katalog.filter((p) => p.kategori === 'hampers');
const urutHarga = (a: { hargaMulai: number | null }, b: { hargaMulai: number | null }) => (a.hargaMulai ?? 0) - (b.hargaMulai ?? 0);
const reguler = hampers.filter((p) => p.musim.length === 0).sort(urutHarga);
// musim aktif tampil paling atas
const urutanMusim: MusimId[] = [MUSIM_AKTIF, ...(['natal', 'imlek', 'lebaran'] as MusimId[]).filter((m) => m !== MUSIM_AKTIF)].filter((m) => m !== 'reguler');
const perMusim = urutanMusim
  .map((m) => ({ musim: DAFTAR_MUSIM[m], produk: hampers.filter((p) => p.musim.includes(m)).sort(urutHarga) }))
  .filter((x) => x.produk.length);

const besok = new Date(Date.now() + SITUS.preorderHari * 864e5).toISOString().slice(0, 10);

const LANGKAH = [
  { ikon: 'hadiah', judul: 'Pilih paket', teks: 'Pilih hampers di bawah, atau ceritakan isi yang kamu mau.' },
  { ikon: 'kartu', judul: 'Tulis ucapan', teks: 'Sertakan pesan kartu ucapan untuk setiap paket.' },
  { ikon: 'kalender', judul: `Pesan H-${SITUS.preorderHari}`, teks: 'Minimal 3 hari sebelum tanggal ambil atau kirim.' },
  { ikon: 'truk', judul: 'Ambil atau diantar', teks: 'Ambil di outlet, atau kami antar di area Makassar.' },
] as const;
---
<Base
  judul="Hampers Makassar & Pesanan Musiman"
  deskripsi="Hampers kue kering Makassar untuk Lebaran, Natal, Imlek, dan hantaran kantor. Isi bisa custom, ada kartu ucapan, pesan minimal H-3 via WhatsApp."
>
  <Jejak jejak={[{ nama: 'Hampers & Musiman', href: '/hampers/' }]} />
  <header class="wadah kepala-halaman kepala-hampers">
    <div>
      <span class="eyebrow">Hampers & pesanan musiman</span>
      <h1>Hampers untuk setiap momen</h1>
      <p class="lead">Kue kering pilihan dalam kemasan hadiah, untuk keluarga, relasi, dan kantor. Isi bisa disesuaikan dan setiap paket bisa dilengkapi kartu ucapan.</p>
      <div class="aksi">
        <a class="btn" href="#paket">Lihat Paket</a>
        <a class="btn btn--garis" href="#partai-besar">Pesanan Kantor</a>
      </div>
    </div>
    <Foto foto={{ src: null, alt: 'Beberapa hampers Teratai tersusun dengan pita dan kartu ucapan', label: 'Hampers tersusun + kartu ucapan' }} jenis="hampers" rasio="4 / 3" eager sizes="(min-width: 900px) 520px, 100vw" class="kepala-hampers__foto" />
  </header>

  <section class="bagian" aria-labelledby="judul-langkah">
    <div class="wadah">
      <h2 id="judul-langkah" class="sr-only">Cara pesan hampers</h2>
      <ol class="langkah">
        {LANGKAH.map((l, i) => (
          <li><span class="langkah__ikon"><Icon nama={l.ikon} /></span><span class="langkah__no angka">0{i + 1}</span><strong>{l.judul}</strong><span>{l.teks}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section id="paket" class="bagian bagian--cream" aria-labelledby="judul-paket">
    <div class="wadah">
      {perMusim.map(({ musim, produk }) => (
        <div class="grup-paket" data-musim={musim.id}>
          <div class="kepala-bagian">
            <div>
              <span class="eyebrow grup-paket__eyebrow">Edisi {musim.label}</span>
              <h2 id={musim.id === MUSIM_AKTIF ? 'judul-paket' : undefined}>Hampers {musim.label}</h2>
            </div>
          </div>
          <div class="grid-produk">{produk.map((p) => <ProductCard produk={p} musim />)}</div>
        </div>
      ))}
      <div class="grup-paket">
        <div class="kepala-bagian">
          <div>
            <span class="eyebrow">Sepanjang tahun</span>
            <h2 id={perMusim.length ? undefined : 'judul-paket'}>Hampers Reguler</h2>
            <p>Untuk ulang tahun, terima kasih, atau hantaran kapan saja.</p>
          </div>
        </div>
        <div class="grid-produk">{reguler.map((p) => <ProductCard produk={p} />)}</div>
      </div>
      <p class="catatan"><Icon nama="info" ukuran={18} /> Ketersediaan paket musiman mengikuti periode hari raya. <span class="tanda">[perlu konfirmasi: paket yang masih dijual]</span></p>
    </div>
  </section>

  <section class="bagian" aria-labelledby="judul-info">
    <div class="wadah info-grid">
      <div>
        <span class="eyebrow">Sebelum memesan</span>
        <h2 id="judul-info">Info pre-order</h2>
        <ul class="info-daftar">
          <li><strong>Pesan minimal H-{SITUS.preorderHari}.</strong> Saat Lebaran, Natal, dan Imlek kuota bisa cepat penuh, jadi lebih awal lebih aman.</li>
          <li><strong>Kartu ucapan</strong> bisa ditulis untuk setiap paket. Kirim isi pesannya saat memesan. <span class="tanda">[perlu konfirmasi: gratis / berbayar]</span></li>
          <li><strong>Isi custom.</strong> Ganti rasa di dalam hampers sesuai stok yang tersedia.</li>
          <li><strong>Pengiriman</strong> di area Makassar, ongkos kirim dikonfirmasi admin. Luar kota: lihat <a href="/faq/">FAQ</a>.</li>
          <li><strong>Pembayaran</strong> lewat QRIS, transfer, atau tunai di outlet. <span class="tanda">[perlu konfirmasi: DP untuk pre-order]</span></li>
        </ul>
      </div>

      <div id="partai-besar" class="form-kartu">
        <h2>Pesanan kantor & partai besar</h2>
        <p>Isi formulir ini, lalu pesan akan terbuka di WhatsApp untuk dikirim ke admin.</p>
        <form data-form-wa data-wa={SITUS.whatsapp} data-pembuka="Halo Teratai Cookies, saya mau pesan hampers / partai besar:">
          <div class="bidang">
            <label for="pb-nama">Nama</label>
            <input id="pb-nama" name="nama" class="input" required autocomplete="name" />
            <span class="galat" id="galat-pb-nama" data-galat-untuk="nama" hidden>Nama wajib diisi.</span>
          </div>
          <div class="bidang">
            <label for="pb-instansi">Instansi / kantor <span class="bantu">(opsional)</span></label>
            <input id="pb-instansi" name="instansi" class="input" autocomplete="organization" />
          </div>
          <div class="baris-2">
            <div class="bidang">
              <label for="pb-jumlah">Perkiraan jumlah paket</label>
              <input id="pb-jumlah" name="jumlah" type="number" min="1" inputmode="numeric" class="input" required />
              <span class="galat" id="galat-pb-jumlah" data-galat-untuk="jumlah" hidden>Isi jumlah paket.</span>
            </div>
            <div class="bidang">
              <label for="pb-tanggal">Tanggal dibutuhkan</label>
              <input id="pb-tanggal" name="tanggal" type="date" min={besok} class="input" required />
              <span class="galat" id="galat-pb-tanggal" data-galat-untuk="tanggal" hidden>Pilih tanggal minimal H-{SITUS.preorderHari}.</span>
            </div>
          </div>
          <div class="bidang">
            <label for="pb-anggaran">Anggaran per paket <span class="bantu">(opsional)</span></label>
            <input id="pb-anggaran" name="anggaran" class="input" placeholder="Mis. Rp 250.000" />
          </div>
          <fieldset class="bidang">
            <legend>Kartu ucapan</legend>
            <div class="pilihan-kotak pilihan-kotak--baris">
              <label><input type="radio" name="kartu" value="Ya" data-label="Ya, pakai kartu ucapan" checked /> Ya</label>
              <label><input type="radio" name="kartu" value="Tidak" data-label="Tidak perlu" /> Tidak perlu</label>
            </div>
          </fieldset>
          <div class="bidang">
            <label for="pb-catatan">Detail pesanan <span class="bantu">(opsional)</span></label>
            <textarea id="pb-catatan" name="catatan" class="input" placeholder="Rasa yang diinginkan, isi kartu ucapan, alamat kirim"></textarea>
          </div>
          <button type="submit" class="btn btn--wa btn--penuh"><Icon nama="whatsapp" /> Kirim via WhatsApp</button>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  import '@/scripts/form-wa';
</script>

<style>
  .kepala-hampers { display: grid; gap: 28px; align-items: center; }
  .kepala-hampers :global(.kepala-hampers__foto) { border-radius: 20px; }
  @media (min-width: 900px) { .kepala-hampers { grid-template-columns: 1fr 1fr; gap: 56px; } }
  .aksi { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }

  .langkah { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .langkah { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
  .langkah li { position: relative; background: #fff; border: 1px solid var(--garis); border-radius: var(--r-lg); padding: 18px; display: grid; gap: 4px; align-content: start; }
  .langkah__ikon { width: 44px; height: 44px; border-radius: 999px; background: var(--cream); display: grid; place-items: center; color: var(--terracotta); margin-bottom: 8px; }
  .langkah__no { position: absolute; top: 18px; right: 18px; font-size: 0.75rem; font-weight: 600; color: var(--teks-2); }
  .langkah strong { font-family: var(--font-judul); }
  .langkah span:last-child { font-size: 0.875rem; color: var(--teks-2); }

  .grup-paket + .grup-paket { margin-top: 56px; }
  .grup-paket__eyebrow { color: var(--musim-badge); }
  .catatan { display: flex; gap: 8px; align-items: flex-start; margin-top: 32px; font-size: 0.875rem; color: var(--teks-2); }

  .info-grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .info-grid { grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; } }
  .info-daftar { padding-left: 1.1em; display: grid; gap: 12px; color: var(--teks-2); }
  .info-daftar strong { color: var(--espresso); }
  .info-daftar a { color: var(--teks-aksen); }
  .form-kartu { background: #fff; border: 1px solid var(--garis); border-radius: var(--r-lg); padding: 24px; box-shadow: var(--bayang); scroll-margin-top: calc(var(--header-h) + 16px); }
  .form-kartu h2 { font-size: 1.375rem; }
  .form-kartu > p { color: var(--teks-2); font-size: 0.9375rem; }
  .baris-2 { display: grid; gap: 0 12px; }
  @media (min-width: 480px) { .baris-2 { grid-template-columns: 1fr 1fr; } }
  fieldset.bidang { border: 0; padding: 0; margin: 0 0 16px; }
  .pilihan-kotak--baris { grid-template-columns: 1fr 1fr; }
</style>
