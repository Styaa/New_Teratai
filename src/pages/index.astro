---
import Base from '@/layouts/Base.astro';
import Foto from '@/components/Foto.astro';
import Icon from '@/components/Icon.astro';
import OutletCard from '@/components/OutletCard.astro';
import ProductCard from '@/components/ProductCard.astro';
import Rak from '@/components/Rak.astro';
import SeasonalBanner from '@/components/SeasonalBanner.astro';
import { DAFTAR_MUSIM, MUSIM_AKTIF } from '@/config/musim';
import { KELUARGA_USAHA, OUTLET, SITUS } from '@/config/situs';
import { getKatalog } from '@/lib/katalog';
import { linkWa } from '@/lib/pesan-wa';
import { schemaBisnis } from '@/lib/seo';
import type { MusimId, Produk } from '@/lib/types';

const katalog = await getKatalog();
const terlaris = katalog.filter((p) => p.best).sort((a, b) => a.peringkat - b.peringkat);
const hampersReguler = katalog.filter((p) => p.kategori === 'hampers' && p.musim.length === 0).sort((a, b) => a.peringkat - b.peringkat).slice(0, 3);

/** Koleksi per musim: hampers musim tsb dulu, lalu rasa khas musim. Maks 4. */
const koleksi = (m: MusimId): Produk[] => {
  if (m === 'reguler') return [...hampersReguler, ...terlaris].slice(0, 4);
  const hampers = katalog.filter((p) => p.kategori === 'hampers' && p.musim.includes(m)).sort((a, b) => (a.hargaMulai ?? 0) - (b.hargaMulai ?? 0));
  const kue = katalog.filter((p) => p.kategori === 'kue-kering' && p.musim.includes(m)).sort((a, b) => a.peringkat - b.peringkat);
  return [...kue.slice(0, 2), ...hampers.slice(0, 2), ...kue.slice(2)].slice(0, 4);
};

const waHero = linkWa(SITUS.whatsapp, 'Halo Teratai Cookies, saya mau pesan kue.');

const KEUNGGULAN = [
  { ikon: 'rumah', judul: 'Buatan rumahan', teks: 'Dibuat di dapur Teratai sendiri, dalam jumlah yang terjaga.' },
  { ikon: 'daun', judul: 'Bahan pilihan', teks: 'Mentega, keju, dan selai nanas yang kami pilih sendiri.' },
  { ikon: 'toko', judul: '2 outlet di Makassar', teks: 'Ambil langsung di Pelita atau Hertasning.' },
] as const;

const TESTIMONI = [
  { nama: '[contoh] Nama Pelanggan', teks: '[contoh] Testimoni asli pelanggan akan ditampilkan di sini setelah dikumpulkan dan diizinkan.' },
  { nama: '[contoh] Nama Pelanggan', teks: '[contoh] Gunakan kutipan nyata dari Instagram, WhatsApp, atau ulasan Google Maps.' },
  { nama: '[contoh] Nama Pelanggan', teks: '[contoh] Jangan tampilkan rating atau jumlah pelanggan sebelum ada datanya.' },
];
---
<Base
  judul="Teratai Cookies | Kue Kering, Nastar & Hampers Makassar"
  deskripsi="Kue kering rumahan dari Makassar: nastar, kastengel, kue keju, dan hampers Lebaran, Natal, Imlek. Pesan via WhatsApp, ambil di outlet Pelita atau Hertasning."
  jsonLd={schemaBisnis()}
>
  <!-- HERO -->
  <section class="hero">
    <div class="wadah hero__grid">
      <div class="hero__teks">
        <span class="eyebrow">Kue kering rumahan · Makassar</span>
        <h1>Renyahnya bikin ingat rumah.</h1>
        <p class="lead">{SITUS.deskripsi}</p>
        <div class="hero__cta">
          <a class="btn btn--wa" href={waHero} target="_blank" rel="noopener"><Icon nama="whatsapp" /> Pesan via WhatsApp</a>
          <a class="btn btn--garis" href="/produk/">Lihat Produk</a>
        </div>
      </div>
      <div class="hero__media">
        <Foto
          foto={{ src: null, alt: 'Close-up nastar Teratai dengan remahan keju di atas talenan kayu', label: 'Hero: close-up nastar, cahaya alami' }}
          jenis="hero"
          rasio="4 / 5"
          eager
          sizes="(min-width: 900px) 520px, 100vw"
          class="hero__foto"
        />
        <div class="hero__kartu" aria-hidden="true">
          <span class="badge badge--favorit">Favorit</span>
          <strong>Nastar</strong>
          <span class="harga">mulai Rp 30.000</span>
        </div>
      </div>
    </div>
  </section>

  <!-- KEUNGGULAN -->
  <section class="keunggulan" aria-label="Keunggulan Teratai">
    <ul class="wadah keunggulan__daftar">
      {KEUNGGULAN.map((k) => (
        <li><span class="keunggulan__ikon"><Icon nama={k.ikon} /></span><div><strong>{k.judul}</strong><span>{k.teks}</span></div></li>
      ))}
    </ul>
  </section>

  <SeasonalBanner />

  <!-- TERLARIS -->
  <section class="bagian" aria-labelledby="judul-terlaris">
    <div class="wadah">
      <div class="kepala-bagian">
        <div>
          <span class="eyebrow">Paling sering dipesan</span>
          <h2 id="judul-terlaris">Kue Terlaris</h2>
        </div>
      </div>
      <Rak label="Kue terlaris">
        {terlaris.map((p, i) => <ProductCard produk={p} eager={i < 2} />)}
      </Rak>
      <a class="tautan-panah" href="/produk/">Lihat Semua Kue <Icon nama="panah" /></a>
    </div>
  </section>

  <!-- KOLEKSI MUSIMAN -->
  <section class="bagian bagian--cream koleksi" aria-labelledby="judul-koleksi">
    <div class="wadah">
      {Object.values(DAFTAR_MUSIM).map((m) => (
        <div data-musim-isi={m.id} hidden={m.id !== MUSIM_AKTIF}>
          <div class="kepala-bagian">
            <div>
              <span class="eyebrow koleksi__eyebrow">Edisi {m.label}</span>
              <h2 id={m.id === MUSIM_AKTIF ? 'judul-koleksi' : undefined}>{m.koleksi.judul}</h2>
              <p>{m.koleksi.sub}</p>
            </div>
            <a class="tautan-panah" href="/hampers/">Info pre-order <Icon nama="panah" /></a>
          </div>
          <div class="grid-produk">
            {koleksi(m.id).map((p) => <ProductCard produk={p} musim={m.id !== 'reguler'} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- HAMPERS -->
  <section class="bagian" aria-labelledby="judul-hampers">
    <div class="wadah hampers">
      <div class="hampers__media">
        <Foto foto={{ src: null, alt: 'Hampers Teratai berisi tiga toples kue kering dengan pita', label: 'Hampers 3 toples + kartu ucapan' }} jenis="hampers" rasio="5 / 4" sizes="(min-width: 900px) 560px, 100vw" />
      </div>
      <div class="hampers__teks">
        <span class="eyebrow">Hampers & hantaran</span>
        <h2 id="judul-hampers">Hadiah manis, isi bisa kamu pilih</h2>
        <p class="lead">Hampers mulai Rp 210.000 untuk keluarga, relasi, dan kantor. Pilih rasa, tambahkan kartu ucapan, kami siapkan rapi.</p>
        <ul class="daftar-centang">
          <li><Icon nama="centang" ukuran={20} /> Isi bisa custom sesuai rasa favorit</li>
          <li><Icon nama="centang" ukuran={20} /> Kartu ucapan untuk setiap paket</li>
          <li><Icon nama="centang" ukuran={20} /> Pesanan kantor & partai besar, pesan minimal H-{SITUS.preorderHari}</li>
        </ul>
        <div class="hero__cta">
          <a class="btn" href="/hampers/">Lihat Hampers</a>
          <a class="btn btn--garis" href="/produk/?kategori=hampers">Semua Paket</a>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONI (placeholder) -->
  <section class="bagian bagian--cream" aria-labelledby="judul-testimoni">
    <div class="wadah">
      <div class="kepala-bagian">
        <div>
          <span class="eyebrow">Kata pelanggan</span>
          <h2 id="judul-testimoni">Dari meja tamu mereka</h2>
          <p><span class="tanda">[contoh]</span> Bagian ini menunggu testimoni asli. Tidak ada ulasan yang dikarang.</p>
        </div>
      </div>
      <ul class="testimoni">
        {TESTIMONI.map((t) => (
          <li class="testimoni__kartu">
            <Icon nama="hati" ukuran={22} class="testimoni__ikon" />
            <blockquote>{t.teks}</blockquote>
            <span class="testimoni__nama">{t.nama}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- OUTLET -->
  <section class="bagian" aria-labelledby="judul-outlet">
    <div class="wadah">
      <div class="kepala-bagian">
        <div>
          <span class="eyebrow">Kunjungi kami</span>
          <h2 id="judul-outlet">Dua outlet di Makassar</h2>
          <p>Ambil pesananmu langsung, atau mampir untuk mencicipi.</p>
        </div>
        <a class="tautan-panah" href="/outlet/">Lihat peta <Icon nama="panah" /></a>
      </div>
      <div class="grid-outlet">
        {OUTLET.map((o) => <OutletCard outlet={o} />)}
      </div>
    </div>
  </section>

  <!-- DARI DAPUR YANG SAMA -->
  <section class="bagian bagian--cream keluarga" aria-labelledby="judul-keluarga">
    <div class="wadah">
      <span class="eyebrow">Dari dapur yang sama</span>
      <h2 id="judul-keluarga" class="keluarga__judul">Keluarga usaha Teratai</h2>
      <ul class="keluarga__daftar">
        {KELUARGA_USAHA.map((k) => (
          <li>
            <strong>{k.nama}</strong>
            <span>{k.deskripsi}</span>
            {k.tautan ? <a class="tautan-panah" href={k.tautan}>Lihat menu <Icon nama="panah" /></a> : <span class="tanda">[link {k.nama}]</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA PENUTUP -->
  <section class="penutup">
    <div class="wadah penutup__isi">
      <h2>Sudah tahu mau pesan apa?</h2>
      <p>Pilih kue, masukkan ke pesanan, lalu kirim lewat WhatsApp. Admin kami akan membalas untuk konfirmasi.</p>
      <div class="hero__cta">
        <a class="btn btn--terang" href="/produk/">Pesan Sekarang</a>
        <a class="btn btn--garis-terang" href={waHero} target="_blank" rel="noopener"><Icon nama="whatsapp" /> Tanya dulu</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 20px 40px; overflow: hidden; }
  .hero__grid { display: grid; gap: 28px; align-items: center; }
  .hero__teks h1 { margin-bottom: 16px; max-width: 12ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .hero__cta .btn { flex: 1 1 auto; }
  @media (min-width: 480px) { .hero__cta .btn { flex: 0 0 auto; } }
  .hero__media { position: relative; }
  .hero__media :global(.hero__foto) { border-radius: 20px; }
  @media (max-width: 899px) { .hero__media :global(.hero__foto) { aspect-ratio: 1 / 1 !important; } }
  .hero__kartu {
    position: absolute; left: 14px; bottom: 14px; background: #fff; border-radius: var(--r); padding: 12px 16px;
    box-shadow: var(--bayang-angkat); display: grid; gap: 2px; min-width: 160px;
  }
  .hero__kartu .badge { justify-self: start; margin-bottom: 4px; }
  .hero__kartu strong { font-family: var(--font-judul); font-size: 1.0625rem; }
  .hero__kartu .harga { font-size: 0.875rem; color: var(--teks-2); }
  @media (min-width: 900px) {
    .hero { padding-block: 48px 72px; }
    .hero__grid { grid-template-columns: 1.05fr 0.95fr; gap: 64px; }
    .hero__kartu { left: -28px; bottom: 40px; }
  }

  .keunggulan { border-block: 1px solid var(--garis); background: #fff; }
  .keunggulan__daftar { list-style: none; margin: 0 auto; display: grid; gap: 0; padding-block: 8px; }
  .keunggulan__daftar li { display: flex; gap: 14px; align-items: flex-start; padding: 14px 0; }
  .keunggulan__daftar li + li { border-top: 1px solid var(--garis); }
  .keunggulan__daftar strong { display: block; font-family: var(--font-judul); font-size: 1rem; }
  .keunggulan__daftar span { font-size: 0.875rem; color: var(--teks-2); }
  .keunggulan__ikon { flex: none; width: 44px; height: 44px; border-radius: 999px; background: var(--cream); display: grid; place-items: center; color: var(--terracotta); }
  @media (min-width: 768px) {
    .keunggulan__daftar { grid-template-columns: repeat(3, 1fr); padding-block: 24px; }
    .keunggulan__daftar li { padding: 4px 24px; }
    .keunggulan__daftar li + li { border-top: 0; border-left: 1px solid var(--garis); }
    .keunggulan__daftar li:first-child { padding-left: 0; }
  }

  .bagian :global(.tautan-panah) { margin-top: 12px; }
  .koleksi__eyebrow { color: var(--musim-badge); }
  .koleksi [hidden] { display: none; }

  .hampers { display: grid; gap: 28px; align-items: center; }
  .hampers__media :global(.foto) { border-radius: 20px; }
  @media (min-width: 900px) { .hampers { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .daftar-centang { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 10px; }
  .daftar-centang li { display: flex; gap: 10px; align-items: flex-start; }
  .daftar-centang :global(svg) { flex: none; color: #1f7a4d; margin-top: 2px; }

  .testimoni { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  @media (min-width: 768px) { .testimoni { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  .testimoni__kartu { background: #fff; border: 1px dashed var(--garis-tegas); border-radius: var(--r-lg); padding: 22px; display: grid; gap: 12px; align-content: start; }
  .testimoni__kartu :global(.testimoni__ikon) { color: var(--terracotta); }
  .testimoni blockquote { margin: 0; color: var(--teks-2); font-size: 0.9375rem; }
  .testimoni__nama { font-weight: 600; font-size: 0.875rem; }

  .grid-outlet { display: grid; gap: 16px; }
  @media (min-width: 768px) { .grid-outlet { grid-template-columns: 1fr 1fr; gap: 24px; } }

  .keluarga__judul { font-size: clamp(1.4rem, 3.5vw, 1.9rem); }
  .keluarga__daftar { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 12px; }
  .keluarga__daftar li { background: #fff; border: 1px solid var(--garis); border-radius: var(--r-lg); padding: 20px; display: grid; gap: 4px; }
  .keluarga__daftar strong { font-family: var(--font-judul); font-size: 1.0625rem; }
  .keluarga__daftar span { color: var(--teks-2); font-size: 0.9375rem; }
  .keluarga__daftar .tanda { justify-self: start; margin-top: 6px; }
  @media (min-width: 768px) { .keluarga__daftar { grid-template-columns: 1fr 1fr; gap: 20px; } }

  .penutup { background: var(--espresso); color: #fff; padding-block: 64px; text-align: center; }
  .penutup__isi { max-width: 680px; }
  .penutup h2 { color: #fff; }
  .penutup p { color: #d8ccc1; }
  .penutup .hero__cta { justify-content: center; }
  .btn--garis-terang { --_bg: transparent; --_fg: #fff; --_bd: rgb(255 255 255 / 0.4); }
  .btn--garis-terang:hover { --_bg: rgb(255 255 255 / 0.08); --_bd: #fff; }
</style>
