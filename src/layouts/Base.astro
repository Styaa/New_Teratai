---
import '@/styles/global.css';
import CartDrawer from '@/components/CartDrawer.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import WhatsAppFab from '@/components/WhatsAppFab.astro';
import { MUSIM_AKTIF } from '@/config/musim';
import { SITUS } from '@/config/situs';

interface Props {
  judul: string; // tanpa nama brand; brand ditambahkan otomatis
  deskripsi: string;
  gambar?: string;
  jsonLd?: object | object[];
  tipeOg?: 'website' | 'product' | 'article';
  noindex?: boolean;
}
const { judul, deskripsi, gambar = '/og.png', jsonLd, tipeOg = 'website', noindex = false } = Astro.props;
const judulPenuh = judul.includes('Teratai') ? judul : `${judul} | Teratai Cookies Makassar`;
const kanonik = new URL(Astro.url.pathname, SITUS.url).toString();
const ogGambar = new URL(gambar, SITUS.url).toString();
const daftarLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="id" data-musim={MUSIM_AKTIF}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{judulPenuh}</title>
    <meta name="description" content={deskripsi} />
    <link rel="canonical" href={kanonik} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FBF8F4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={tipeOg} />
    <meta property="og:site_name" content={SITUS.namaLengkap} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={judulPenuh} />
    <meta property="og:description" content={deskripsi} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={ogGambar} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
    />
    {daftarLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="lewati" href="#konten">Langsung ke konten</a>
    <Header />
    <main id="konten" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <WhatsAppFab />
    <script>
      import '@/scripts/keranjang';
      import '@/scripts/muncul';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
