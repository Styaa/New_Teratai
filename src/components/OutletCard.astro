---
import { SITUS, alamatLengkap, linkEmbedPeta, linkPetunjukArah, type Outlet } from '@/config/situs';
import { linkWa } from '@/lib/pesan-wa';
import Icon from './Icon.astro';

interface Props { outlet: Outlet; peta?: boolean; tingkat?: 'h2' | 'h3' }
const { outlet: o, peta = false, tingkat = 'h3' } = Astro.props;
const Judul = tingkat;
const wa = linkWa(o.whatsapp || SITUS.whatsapp, `Halo ${o.nama}, saya mau tanya tentang kue.`);
---
<article class="outlet" id={o.id}>
  {peta && (
    <div class="outlet__peta">
      <iframe
        src={linkEmbedPeta(o)}
        title={`Peta lokasi ${o.nama}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  )}
  <div class="outlet__isi">
    <Judul class="outlet__nama">{o.nama}</Judul>
    <p class="outlet__baris"><Icon nama="pin" ukuran={20} /> <span>{alamatLengkap(o)}</span></p>
    <div class="outlet__baris">
      <Icon nama="jam" ukuran={20} />
      {o.jam.length ? (
        <dl class="outlet__jam">
          {o.jam.map((j) => (<><dt>{j.hari}</dt><dd class="angka">{j.buka}–{j.tutup}</dd></>))}
        </dl>
      ) : (
        <span>Jam buka <span class="tanda">[jam buka {o.nama}]</span></span>
      )}
    </div>
    <div class="outlet__aksi">
      <a class="btn btn--kecil" href={linkPetunjukArah(o)} target="_blank" rel="noopener">
        <Icon nama="pin" /> Petunjuk Arah
      </a>
      <a class="btn btn--garis btn--kecil" href={wa} target="_blank" rel="noopener">
        <Icon nama="whatsapp" /> WhatsApp Outlet
      </a>
    </div>
    {!o.whatsapp && <p class="outlet__catatan"><span class="tanda">[nomor WA outlet]</span></p>}
  </div>
</article>

<style>
  .outlet { background: #fff; border: 1px solid var(--garis); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--bayang); display: flex; flex-direction: column; }
  .outlet__peta { aspect-ratio: 16 / 10; background: var(--cream); }
  .outlet__peta iframe { width: 100%; height: 100%; border: 0; display: block; }
  .outlet__isi { padding: 22px; display: grid; gap: 12px; }
  .outlet__nama { font-size: 1.25rem; margin: 0 0 4px; }
  .outlet__baris { display: flex; gap: 10px; align-items: flex-start; margin: 0; color: var(--teks-2); font-size: 0.9375rem; }
  .outlet__baris :global(svg) { flex: none; margin-top: 2px; color: var(--terracotta); }
  .outlet__jam { display: grid; grid-template-columns: auto auto; gap: 2px 16px; margin: 0; }
  .outlet__jam dd { margin: 0; color: var(--espresso); }
  .outlet__aksi { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .outlet__catatan { margin: 0; font-size: 0.8125rem; }
</style>
