---
/**
 * Foto produk / suasana. Bila `foto.src` kosong, tampil placeholder bertanda jelas "[Foto]".
 * Saat foto asli tersedia: simpan di src/assets lalu ganti dengan <Picture> astro:assets (AVIF/WebP otomatis),
 * atau isi PUBLIC_FOTO_BASE agar foto dari admin dipakai (sebaiknya admin menyajikan WebP).
 */
import type { Foto as FotoT } from '@/lib/types';
interface Props {
  foto: FotoT;
  rasio?: string; // "4 / 5"
  jenis?: 'kue' | 'toples' | 'cake' | 'hampers' | 'dapur' | 'tim' | 'hero';
  sizes?: string;
  eager?: boolean;
  class?: string;
  label?: boolean; // tampilkan label placeholder
}
const { foto, rasio = '4 / 5', jenis = 'kue', sizes = '(min-width: 1024px) 25vw, 50vw', eager = false, class: kelas, label = true } = Astro.props;

const ilustrasi: Record<string, string> = {
  kue: `<g fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="70" cy="86" r="30"/><circle cx="70" cy="86" r="21" stroke-dasharray="2 5"/><circle cx="128" cy="68" r="24"/><circle cx="128" cy="68" r="15" stroke-dasharray="2 5"/><circle cx="122" cy="122" r="20"/><circle cx="122" cy="122" r="12" stroke-dasharray="2 5"/></g><g fill="currentColor"><circle cx="62" cy="80" r="1.6"/><circle cx="77" cy="92" r="1.6"/><circle cx="132" cy="62" r="1.4"/><circle cx="118" cy="118" r="1.4"/></g>`,
  toples: `<g fill="none" stroke="currentColor" stroke-width="1.4"><rect x="62" y="42" width="76" height="14" rx="5"/><path d="M58 56h84v8c6 4 8 10 8 16v44a14 14 0 0 1-14 14H64a14 14 0 0 1-14-14V80c0-6 2-12 8-16v-8Z"/><circle cx="80" cy="96" r="11"/><circle cx="106" cy="92" r="10"/><circle cx="96" cy="116" r="10"/><circle cx="122" cy="114" r="9"/></g>`,
  cake: `<g fill="none" stroke="currentColor" stroke-width="1.4"><ellipse cx="100" cy="74" rx="52" ry="14"/><path d="M48 74v44c0 8 23 14 52 14s52-6 52-14V74"/><path d="M48 96c0 8 23 14 52 14s52-6 52-14"/><path d="M100 46v14M96 50h8"/></g>`,
  hampers: `<g fill="none" stroke="currentColor" stroke-width="1.4"><rect x="50" y="76" width="100" height="62" rx="6"/><path d="M44 66h112v12H44zM100 66v72"/><path d="M100 66c-8-16-30-18-28-6 2 8 18 6 28 6Zm0 0c8-16 30-18 28-6-2 8-18 6-28 6Z"/></g>`,
  dapur: `<g fill="none" stroke="currentColor" stroke-width="1.4"><path d="M56 112h88M64 112V88a36 36 0 0 1 72 0v24"/><path d="M100 52v-8M84 60l-4-6M116 60l4-6"/><circle cx="100" cy="92" r="6"/></g>`,
  tim: `<g fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="76" cy="78" r="14"/><path d="M50 132c0-16 12-28 26-28s26 12 26 28"/><circle cx="126" cy="74" r="16"/><path d="M98 132c0-18 12-32 28-32s28 14 28 32"/></g>`,
  hero: `<g fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="76" cy="96" r="34"/><circle cx="76" cy="96" r="24" stroke-dasharray="2 5"/><circle cx="136" cy="72" r="26"/><circle cx="136" cy="72" r="17" stroke-dasharray="2 5"/><circle cx="132" cy="132" r="22"/><circle cx="132" cy="132" r="14" stroke-dasharray="2 5"/><path d="M30 160c40-10 100-10 140 0" stroke-dasharray="1 6"/></g>`,
};
---
{foto.src ? (
  <img
    class:list={['foto', kelas]}
    src={foto.src}
    alt={foto.alt}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    width="800"
    height="1000"
    style={`aspect-ratio:${rasio}`}
  />
) : (
  <div class:list={['foto foto--placeholder', `foto--${jenis}`, kelas]} style={`aspect-ratio:${rasio}`} role="img" aria-label={`Placeholder foto: ${foto.alt}`}>
    <svg viewBox="0 0 200 180" aria-hidden="true" set:html={ilustrasi[jenis] ?? ilustrasi.kue} />
    {label && <span class="foto__label">[Foto] {foto.label}</span>}
  </div>
)}

<style>
  .foto { width: 100%; object-fit: cover; border-radius: inherit; background: var(--cream); }
  .foto--placeholder {
    position: relative; display: grid; place-items: center; overflow: hidden; color: #b99a83;
    background:
      radial-gradient(120% 90% at 20% 15%, #fffaf4 0%, transparent 60%),
      radial-gradient(90% 80% at 90% 100%, #ead9c8 0%, transparent 65%),
      linear-gradient(160deg, #f6ede3, #efe1d2);
  }
  .foto--placeholder::after {
    /* tekstur linen halus */
    content: ''; position: absolute; inset: 0; opacity: 0.35; pointer-events: none;
    background-image: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.25) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(90deg, rgb(160 120 90 / 0.06) 0 1px, transparent 1px 5px);
  }
  .foto--hero .foto__label { top: 12px; bottom: auto; left: 12px; }
  .foto--hampers { color: #b4917a; background: linear-gradient(160deg, #f4e9de, #e9d6c4); }
  .foto--cake { color: #b3977f; background: linear-gradient(160deg, #f8efe6, #eedfce); }
  .foto--placeholder svg { width: 64%; max-width: 280px; height: auto; position: relative; z-index: 1; }
  .foto__label {
    position: absolute; left: 10px; bottom: 10px; z-index: 2; max-width: calc(100% - 20px);
    font: 600 0.6875rem/1.3 ui-monospace, 'SF Mono', Menlo, monospace; letter-spacing: 0.01em;
    color: #6b5a4c; background: rgb(255 255 255 / 0.85); border: 1px dashed #c9b29d; border-radius: 6px;
    padding: 3px 7px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
</style>
