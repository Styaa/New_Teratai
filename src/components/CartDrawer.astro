---
import { OUTLET, SITUS } from '@/config/situs';
import Icon from './Icon.astro';

const konfig = {
  waUtama: SITUS.whatsapp,
  outlet: OUTLET.map((o) => ({ id: o.id, nama: o.nama, wa: o.whatsapp })),
  preorderHari: SITUS.preorderHari,
};
---
<dialog class="laci" data-laci aria-labelledby="laci-judul" data-konfig={JSON.stringify(konfig)}>
  <div class="laci__panel">
    <header class="laci__kepala">
      <h2 id="laci-judul">Pesanan Saya</h2>
      <button type="button" class="laci__tutup" data-tutup-laci aria-label="Tutup pesanan"><Icon nama="tutup" /></button>
    </header>

    <div class="laci__isi">
      <div class="laci__kosong" data-laci-kosong>
        <Icon nama="keranjang" ukuran={40} />
        <p><strong>Pesananmu masih kosong.</strong><br />Pilih kue favoritmu dulu, nanti pesanan dikirim lewat WhatsApp.</p>
        <a href="/produk/" class="btn">Lihat Semua Kue</a>
      </div>

      <ul class="laci__daftar" data-laci-daftar aria-live="polite"></ul>

      <form class="laci__form" data-form-checkout novalidate hidden>
        <fieldset class="bidang">
          <legend>Cara terima pesanan</legend>
          <div class="pilihan-kotak">
            {OUTLET.map((o, i) => (
              <label><input type="radio" name="terima" value={`ambil:${o.id}`} checked={i === 0} /> Ambil di {o.nama}</label>
            ))}
            <label><input type="radio" name="terima" value="antar" /> Diantar</label>
          </div>
        </fieldset>

        <div class="bidang" data-bidang-alamat hidden>
          <label for="co-alamat">Alamat pengiriman</label>
          <textarea id="co-alamat" name="alamat" class="input" rows="2" autocomplete="street-address" placeholder="Nama jalan, nomor rumah, patokan"></textarea>
          <span class="bantu">Ongkos kirim dikonfirmasi admin lewat WhatsApp.</span>
          <span class="galat" data-galat="alamat" hidden>Alamat wajib diisi untuk pesanan diantar.</span>
        </div>

        <div class="bidang">
          <label for="co-tanggal" data-label-tanggal>Tanggal ambil</label>
          <input id="co-tanggal" name="tanggal" type="date" class="input" required />
          <span class="bantu">Hampers dan pesanan partai besar: minimal H-{SITUS.preorderHari}.</span>
          <span class="galat" data-galat="tanggal" hidden>Pilih tanggal mulai hari ini.</span>
        </div>

        <div class="bidang">
          <label for="co-nama">Nama pemesan</label>
          <input id="co-nama" name="nama" type="text" class="input" autocomplete="name" required />
          <span class="galat" data-galat="nama" hidden>Nama wajib diisi.</span>
        </div>

        <div class="bidang">
          <label for="co-catatan">Catatan <span class="bantu">(opsional)</span></label>
          <textarea id="co-catatan" name="catatan" class="input" rows="2" placeholder="Mis. kartu ucapan, jam ambil, pilihan rasa hampers"></textarea>
        </div>
      </form>
    </div>

    <footer class="laci__kaki" data-laci-kaki hidden>
      <div class="laci__total">
        <span>Total</span>
        <strong class="harga" data-laci-total>Rp 0</strong>
      </div>
      <p class="laci__catatan" data-laci-catatan-harga hidden>Sebagian harga akan dikonfirmasi admin.</p>
      <button type="submit" form="" class="btn btn--wa btn--penuh" data-kirim-wa>
        <Icon nama="whatsapp" /> Kirim Pesanan via WhatsApp
      </button>
      <p class="laci__catatan">Belum ada pembayaran di sini. Admin akan membalas untuk konfirmasi stok dan pembayaran.</p>
    </footer>
  </div>
</dialog>

<style>
  .laci {
    margin: 0 0 0 auto; padding: 0; border: 0; width: min(100%, 440px); max-width: 100%; height: 100dvh; max-height: 100dvh;
    background: transparent; color: var(--espresso);
  }
  .laci::backdrop { background: rgb(42 36 32 / 0.45); }
  .laci[open] .laci__panel { animation: geser-masuk 260ms var(--ease); }
  @keyframes geser-masuk { from { transform: translateX(24px); opacity: 0; } }
  .laci__panel { height: 100%; display: flex; flex-direction: column; background: var(--cream-muda); }
  .laci__kepala { display: flex; align-items: center; justify-content: space-between; padding: 12px 12px 12px 20px; border-bottom: 1px solid var(--garis); }
  .laci__kepala h2 { font-size: 1.25rem; margin: 0; }
  .laci__tutup { width: 48px; height: 48px; border: 0; background: none; border-radius: 999px; cursor: pointer; display: grid; place-items: center; }
  .laci__tutup:hover { background: var(--cream); }
  .laci__isi { flex: 1; overflow-y: auto; padding: 16px 20px 24px; overscroll-behavior: contain; }
  .laci__kosong { text-align: center; padding: 48px 8px; color: var(--teks-2); display: grid; justify-items: center; gap: 12px; }
  .laci__kosong[hidden] { display: none; }
  .laci__daftar { list-style: none; padding: 0; margin: 0 0 20px; display: grid; gap: 12px; }
  .laci__form[hidden] { display: none; }
  .laci__kaki { padding: 16px 20px calc(16px + env(safe-area-inset-bottom)); border-top: 1px solid var(--garis); background: #fff; display: grid; gap: 10px; }
  .laci__kaki[hidden] { display: none; }
  .laci__total { display: flex; justify-content: space-between; align-items: baseline; font-size: 1.0625rem; }
  .laci__total strong { font-family: var(--font-judul); font-size: 1.375rem; }
  .laci__catatan { margin: 0; font-size: 0.8125rem; color: var(--teks-2); text-align: center; }
  .laci__catatan[hidden] { display: none; }

  :global(.item-laci) { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 14px; background: #fff; border: 1px solid var(--garis); border-radius: var(--r); }
  :global(.item-laci__nama) { font-weight: 600; line-height: 1.3; }
  :global(.item-laci__varian) { font-size: 0.875rem; color: var(--teks-2); }
  :global(.item-laci__subtotal) { font-weight: 600; text-align: right; }
  :global(.item-laci__baris) { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
  :global(.item-laci__hapus) { border: 0; background: none; color: var(--teks-2); font-size: 0.875rem; display: inline-flex; gap: 4px; align-items: center; min-height: 44px; cursor: pointer; padding: 0 4px; }
  :global(.item-laci__hapus:hover) { color: #b3261e; }
</style>
