---
/** Tombol WhatsApp melayang. Di HP selalu terlihat; bila keranjang berisi, membuka keranjang. */
import { SITUS } from '@/config/situs';
import { linkWa } from '@/lib/pesan-wa';
import Icon from './Icon.astro';
const href = linkWa(SITUS.whatsapp, 'Halo Teratai Cookies, saya mau tanya tentang kue.');
---
<div class="fab">
  <button type="button" class="fab__keranjang" data-buka-keranjang data-fab-keranjang hidden>
    <Icon nama="keranjang" ukuran={22} />
    <span>Pesanan</span>
    <span class="fab__jumlah angka" data-jumlah-keranjang>0</span>
  </button>
  <a class="fab__wa" href={href} target="_blank" rel="noopener" aria-label="Chat WhatsApp Teratai Cookies">
    <Icon nama="whatsapp" ukuran={26} />
  </a>
</div>

<script>
  // Tampilkan tombol "Pesanan" melayang hanya bila keranjang berisi
  const tombol = document.querySelector<HTMLElement>('[data-fab-keranjang]');
  const jumlah = tombol?.querySelector<HTMLElement>('[data-jumlah-keranjang]');
  if (tombol && jumlah) {
    const cek = () => { tombol.hidden = jumlah.hidden || jumlah.textContent === '0'; };
    new MutationObserver(cek).observe(jumlah, { attributes: true, childList: true, characterData: true, subtree: true });
    cek();
  }
</script>

<style>
  .fab {
    position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 30;
    display: flex; align-items: center; gap: 10px;
  }
  .fab__wa {
    width: 56px; height: 56px; border-radius: 999px; display: grid; place-items: center;
    background: #1f7a4d; color: #fff; box-shadow: 0 6px 20px rgb(31 122 77 / 0.35);
    transition: transform var(--durasi) var(--ease), background var(--durasi);
  }
  .fab__wa:hover { background: #17623d; transform: translateY(-2px); }
  .fab__keranjang {
    display: inline-flex; align-items: center; gap: 8px; height: 52px; padding: 0 8px 0 18px; border-radius: 999px;
    border: 0; background: var(--espresso); color: #fff; font-weight: 600; cursor: pointer;
    box-shadow: 0 6px 20px rgb(42 36 32 / 0.25);
  }
  .fab__keranjang[hidden] { display: none; }
  .fab__jumlah { min-width: 30px; height: 30px; padding: 0 8px; border-radius: 999px; background: var(--terracotta); display: grid; place-items: center; font-size: 0.875rem; }
  .fab__jumlah[hidden] { display: grid !important; }
</style>
