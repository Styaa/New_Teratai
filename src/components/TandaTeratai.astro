---
/** Gambar ulang tanda teratai dari logo Jo&S Teratai (kelopak merah muda di atas daun hijau). */
interface Props { class?: string }
const { class: kelas } = Astro.props;
const kelopak = 'M0 -20C11 -12 11 12 0 20C-11 12 -11 -12 0 -20Z';
---
<svg class={kelas} width="50" height="40" viewBox="0 0 100 80" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="tt-atas" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f05a9d" /><stop offset="1" stop-color="#d4306f" /></linearGradient>
    <linearGradient id="tt-ungu" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#dc8bc0" /><stop offset="1" stop-color="#d64fa0" /></linearGradient>
    <linearGradient id="tt-magenta" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e3166f" /><stop offset="1" stop-color="#cf1d48" /></linearGradient>
    <linearGradient id="tt-daun" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#56b84f" /><stop offset="1" stop-color="#2f9a43" /></linearGradient>
  </defs>
  <ellipse cx="50" cy="60" rx="45" ry="9.5" fill="url(#tt-daun)" />
  <g stroke="#f6d9ea" stroke-width="1.8" stroke-linejoin="round">
    <path d={kelopak} transform="translate(35 24) rotate(-16) scale(.62 .72)" fill="url(#tt-atas)" />
    <path d={kelopak} transform="translate(65 24) rotate(16) scale(.62 .72)" fill="url(#tt-atas)" />
    <path d={kelopak} transform="translate(25 51) rotate(-62) scale(.78 1.02)" fill="url(#tt-magenta)" />
    <path d={kelopak} transform="translate(75 51) rotate(62) scale(.78 1.02)" fill="url(#tt-magenta)" />
    <path d={kelopak} transform="translate(30 40) rotate(-58) scale(.98 1.12)" fill="url(#tt-ungu)" />
    <path d={kelopak} transform="translate(70 40) rotate(58) scale(.98 1.12)" fill="url(#tt-ungu)" />
    <path d={kelopak} transform="translate(50 32) scale(.98 1.12)" fill="url(#tt-ungu)" />
    <path d={kelopak} transform="translate(50 57) scale(.8 .75)" fill="url(#tt-magenta)" />
  </g>
</svg>
