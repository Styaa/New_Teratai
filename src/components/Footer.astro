---
import { OUTLET, SITUS, alamatLengkap, linkPetunjukArah } from '@/config/situs';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
const tahun = new Date().getFullYear();
---
<footer class="footer">
  <div class="wadah footer__grid">
    <div class="footer__brand">
      <Logo terang />
      <p>{SITUS.deskripsi}</p>
      {SITUS.instagram ? (
        <a class="footer__ig" href={`https://instagram.com/${SITUS.instagram}`} rel="noopener" target="_blank">
          <Icon nama="instagram" ukuran={20} /> @{SITUS.instagram}
        </a>
      ) : (
        <p class="footer__ig"><Icon nama="instagram" ukuran={20} /> <span class="tanda">[Instagram]</span></p>
      )}
    </div>

    <nav aria-label="Belanja">
      <h2>Belanja</h2>
      <ul>
        <li><a href="/produk/?kategori=kue-kering">Kue Kering</a></li>
        <li><a href="/produk/?kategori=cake">Cake & Kue Basah</a></li>
        <li><a href="/hampers/">Hampers & Musiman</a></li>
        <li><a href="/reseller/">Program Reseller</a></li>
      </ul>
    </nav>
    <nav aria-label="Informasi">
      <h2>Informasi</h2>
      <ul>
        <li><a href="/tentang/">Tentang Kami</a></li>
        <li><a href="/outlet/">Outlet</a></li>
        <li><a href="/faq/">FAQ</a></li>
      </ul>
    </nav>
    <div>
      <h2>Outlet</h2>
      <ul class="footer__outlet">
        {OUTLET.map((o) => (
          <li>
            <strong>{o.nama}</strong>
            <span>{alamatLengkap(o)}</span>
            <a href={linkPetunjukArah(o)} target="_blank" rel="noopener">Petunjuk Arah</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wadah footer__bawah">
    <p>© {tahun} {SITUS.namaLengkap}, Makassar.</p>
    <p>Harga yang tercantum adalah harga eceran dan dapat berubah sewaktu-waktu.</p>
  </div>
</footer>

<style>
  .footer { background: var(--espresso); color: #e9dfd6; padding: 56px 0 calc(28px + env(safe-area-inset-bottom)); margin-top: 0; }
  .footer__grid { display: grid; gap: 36px; grid-template-columns: 1fr 1fr; }
  .footer__brand { grid-column: 1 / -1; max-width: 360px; }
  .footer__brand p { margin-top: 16px; color: #cbbfb4; font-size: 0.9375rem; }
  .footer h2 { font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.1em; color: #f0c3ab; margin-bottom: 14px; font-weight: 600; }
  .footer ul { list-style: none; margin: 0; padding: 0; }
  .footer nav a { display: inline-flex; min-height: 40px; align-items: center; text-decoration: none; color: #e9dfd6; font-size: 0.9375rem; }
  .footer nav a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .footer__ig { display: inline-flex !important; align-items: center; gap: 8px; color: #e9dfd6; text-decoration: none; min-height: 44px; }
  .footer__outlet { grid-column: 1 / -1; display: grid; gap: 18px; }
  .footer__outlet li { display: grid; gap: 2px; font-size: 0.875rem; color: #cbbfb4; }
  .footer__outlet strong { color: #fff; font-size: 0.9375rem; }
  .footer__outlet a { color: #f0c3ab; min-height: 36px; display: inline-flex; align-items: center; width: fit-content; }
  .footer__grid > div:last-child { grid-column: 1 / -1; }
  .footer__bawah { margin-top: 40px; padding-top: 20px; border-top: 1px solid rgb(255 255 255 / 0.1); font-size: 0.8125rem; color: #a99c90; display: grid; gap: 4px; }
  .footer__bawah p { margin: 0; }
  .footer .tanda { background: #3a322c; color: #f3d98b; border-color: #8a7330; }
  @media (min-width: 900px) {
    .footer { padding-top: 80px; }
    .footer__grid { grid-template-columns: 1.4fr 0.8fr 0.8fr 1.4fr; gap: 48px; }
    .footer__brand, .footer__grid > div:last-child { grid-column: auto; }
    .footer__bawah { display: flex; justify-content: space-between; }
  }
</style>
